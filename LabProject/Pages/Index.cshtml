@page
@model LabProject.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Class Management";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
    body {
        background: linear-gradient(135deg, #f7f9fc 0%, #e2e6f0 100%);
        min-height: 100vh;
    }

    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        background-color: #ffffff;
    }

    .card-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
    }

    .btn-custom {
        min-width: 100px;
        transition: transform 0.3s;
        font-weight: 500;
    }

    .btn-custom:hover {
        transform: scale(1.05);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .table-hover tbody tr:hover {
        background-color: #f9fafb;
    }
    .table td, .table th {
        vertical-align: middle;
    }
    .table-bordered td, .table-bordered th {
        border-color: #dee2e6;
    }

    .display-5 {
        font-weight: 700;
        letter-spacing: -0.5px;
    }
    .text-muted {
        color: #6c757d !important;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        to {
            opacity: 1;
        }
    }
</style>

<div class="container py-5 fade-in">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">📘 Class Management Panel</h1>
        <p class="text-muted">Manage class details easily — add, update, and delete entries.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-custom p-4">
                <h4 class="card-title mb-3 text-primary">
                    <i class="bi bi-journal-plus"></i> Add / Edit Class
                </h4>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input asp-for="ClassInfo.ClassName" class="form-control" placeholder="e.g. CENG 382" />
                        <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input asp-for="ClassInfo.StudentCount" class="form-control" placeholder="e.g. 50" />
                        <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="ClassInfo.Description" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-custom" asp-page-handler="Add">
                        <i class="bi bi-plus-circle me-1"></i> Save Class
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card card-custom p-4">
                <h4 class="card-title mb-3 text-primary">
                    <i class="bi bi-table"></i> Class List
                </h4>

                <table class="table table-hover table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Class Name</th>
                            <th>Student Count</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GetClassList().Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No class data available.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.GetClassList())
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.ClassName</td>
                                    <td>@item.StudentCount</td>
                                    <td>@item.Description</td>
                                    <td class="text-center">
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" asp-page-handler="Edit" class="btn btn-outline-primary btn-sm btn-custom" 
                                                    data-bs-toggle="tooltip" data-bs-placement="top" title="Edit this class">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                        </form>

                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" asp-page-handler="Delete" class="btn btn-outline-danger btn-sm btn-custom"
                                                    data-bs-toggle="tooltip" data-bs-placement="top" title="Delete this class">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    </script>
}
