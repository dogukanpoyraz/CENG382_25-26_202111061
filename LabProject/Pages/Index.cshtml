@page
@model LabProject.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Class Management";
    var keyword = (string)Request.Query["keyword"];
    bool hasKeyword = !string.IsNullOrWhiteSpace(keyword);
}

<!-- AI Prompt: "Build a stylish and responsive Razor Page using Bootstrap 5 to manage class data. 
   Layout must include a left-aligned form and a right-aligned table. 
   The form should support add/edit with validation, and the table should list all entries with edit/delete buttons. 
   Also include a modern popup interface for inline updates and custom styles for better UX." -->

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<!-- Created by me - Custom styles for background, card, table, animations -->
<style>
    body {
        background: linear-gradient(135deg, #f7f9fc 0%, #e2e6f0 100%);
        min-height: 100vh;
    }

    .card-custom {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s, box-shadow 0.3s;
        background-color: #ffffff;
    }

    .card-custom:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
    }

    .btn-custom {
        min-width: 100px;
        transition: transform 0.3s;
        font-weight: 500;
    }

    .btn-custom:hover {
        transform: scale(1.05);
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .table-hover tbody tr:hover {
        background-color: #f9fafb;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .table-bordered td, .table-bordered th {
        border-color: #dee2e6;
    }

    .display-5 {
        font-weight: 700;
        letter-spacing: -0.5px;
    }

    .text-muted {
        color: #6c757d !important;
    }

    .fade-in {
        animation: fadeIn 0.5s ease-in-out forwards;
        opacity: 0;
    }

    @@keyframes fadeIn {
        to {
            opacity: 1;
        }
    }

    td.actions-cell {
        position: relative;
    }

    .update-popup {
        position: absolute;
        top: 2.5rem;
        right: 0;
        z-index: 999;
        width: 300px;
        background-color: #ffffff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        padding: 1rem;
        animation: fadeIn 0.3s ease-in-out forwards;
        opacity: 0;
    }
    .update-popup.fade-in {
        opacity: 1;
    }
</style>

<div class="container py-5 fade-in">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary">📘 Class Management Panel</h1>
        <p class="text-muted">Manage class details easily — add, update, and delete entries.</p>
    </div>

<!-- AI Prompt: "Create a Razor Pages-compatible search and filter UI with pagination. 
     Include a GET-based form that filters a class list by keyword (name or description), 
     and display the filtered results in a styled Bootstrap table. 
     Add pagination controls that preserve the search keyword when navigating between pages." 
     ! I also made my own changes !-->

    <div class="row g-4">
        <!-- Created by me - Form card for adding and editing class data -->
        <div class="col-md-4">
            <div class="card card-custom p-4">
                <h4 class="card-title mb-3 text-primary">
                    <i class="bi bi-journal-plus"></i> Add / Edit Class
                </h4>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Class Name</label>
                        <input asp-for="ClassInfo.ClassName" class="form-control" placeholder="e.g. CENG 382" />
                        <span asp-validation-for="ClassInfo.ClassName" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Student Count</label>
                        <input asp-for="ClassInfo.StudentCount" class="form-control" placeholder="e.g. 50" />
                        <span asp-validation-for="ClassInfo.StudentCount" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="ClassInfo.Description" class="form-control" rows="3" placeholder="Optional notes..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-custom" asp-page-handler="Add">
                        <i class="bi bi-plus-circle me-1"></i> Save Class
                    </button>
                </form>
            </div>
        </div>

        <!-- Created by me - Table view to display and manage class data -->
        <div class="col-md-8">
            <div class="card card-custom p-4">
                <h4 class="card-title mb-3 text-primary">
                    <i class="bi bi-table"></i> Class List
                </h4>
                
                <!-- AI Prompt: "Add a JSON export feature to the Razor Page. Include checkboxes for selecting columns to export, and buttons for exporting all or filtered data." -->
                <form method="post" asp-page-handler="ExportJson" class="mb-2">
                    <div class="mb-3">
                        <label class="form-label">Select Columns to Export:</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input export-checkbox" type="checkbox" name="selectedColumns" value="ClassName" id="chkClassName">
                            <label class="form-check-label" for="chkClassName">Class Name</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input export-checkbox" type="checkbox" name="selectedColumns" value="StudentCount" id="chkStudentCount">
                            <label class="form-check-label" for="chkStudentCount">Student Count</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input export-checkbox" type="checkbox" name="selectedColumns" value="Description" id="chkDescription">
                            <label class="form-check-label" for="chkDescription">Description</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" name="exportType" value="all" class="btn btn-outline-primary">
                            <i class="bi bi-download"></i> Export All to JSON
                        </button>
                        <button type="submit" name="exportType" value="filtered" class="btn btn-outline-success">
                            <i class="bi bi-filter-square"></i> Export Filtered to JSON
                        </button>
                        <button type="button" class="btn btn-outline-danger" id="clearSelectionBtn">
                            <i class="bi bi-x-circle"></i> Clear Table Selection
                        </button>
                        <span id="selectionCount" class="badge bg-primary align-self-center ms-2" style="display: none;"></span>
                    </div>
                    <div id="selectedRowInputs"></div>
                </form>

                <form method="get" class="mb-3">
                    <div class="input-group">
                        <input id="searchBox" type="text" name="keyword" value="@keyword" class="form-control" placeholder="Search by name or description... (Filtering applies automatically as you type)" />
                        <button type="submit" class="btn btn-primary">Filter</button>
                    </div>
                </form>

                @if (hasKeyword)
                {
                    @if (Model.FilteredList != null && Model.FilteredList.Any())
                    {
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Class Name</th>
                                    <th>Student Count</th>
                                    <th>Description</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in Model.FilteredList)
                            {
                                <tr>
                                    <td>@item.ClassName</td>
                                    <td>@item.StudentCount</td>
                                    <td>@item.Description</td>
                                    <td>
                                        <form method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" asp-page-handler="Edit" class="btn btn-sm btn-warning">Edit</button>
                                            <button type="submit" asp-page-handler="Delete" class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-warning">No results found for "<strong>@keyword</strong>".</div>
                    }

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Pagination" class="mt-3">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                        href="?keyword=@keyword&currentPage=@i&sortColumn=@Model.SortColumn&sortAscending=@Model.SortAscending">
                                            @i
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }

                }
                else
                {
                    <table class="table table-hover table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                @* ID column removed - hidden in Display table *@
                                <th class="col-name">
                                    <a asp-page="./Index"
                                    asp-route-currentPage="@Model.CurrentPage"
                                    asp-route-sortColumn="ClassName"
                                    asp-route-sortAscending="@(Model.SortColumn == "ClassName" ? !Model.SortAscending : true)"
                                    class="text-decoration-none text-primary fw-bold">
                                        Class Name
                                        @if (Model.SortColumn == "ClassName")
                                        {
                                            <span class="sort-icon">
                                                @(Model.SortAscending ? "▲" : "▼")
                                            </span>
                                        }
                                    </a>
                                </th>
                                <th class="col-count">
                                    <a asp-page="./Index"
                                    asp-route-currentPage="@Model.CurrentPage"
                                    asp-route-sortColumn="StudentCount"
                                    asp-route-sortAscending="@(Model.SortColumn == "StudentCount" ? !Model.SortAscending : true)"
                                    class="text-decoration-none text-primary fw-bold">
                                        Student Count
                                        @if (Model.SortColumn == "StudentCount")
                                        {
                                            <span class="sort-icon">
                                                @(Model.SortAscending ? "▲" : "▼")
                                            </span>
                                        }
                                    </a>
                                </th>
                                <th>Description</th>
                                <th class="text-center">Actions</th>
                            </tr>
                            </thead>


                        <tbody>
                            @if (Model.PagedDisplayList.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No class data available.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.PagedDisplayList)
                                {
                                    <tr class="selectable-row" data-id="@item.Id">
                                        @* ID cell removed - hidden in Display table *@
                                        <td class="col-name">@item.ClassName</td>
                                        <td class="col-count">@item.StudentCount</td>
                                        <td>@item.Description</td>
                                        <td class="text-center actions-cell">
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" asp-page-handler="Edit"
                                                        class="btn btn-outline-primary btn-sm btn-custom"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="Edit this class">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </form>

                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" asp-page-handler="Delete"
                                                        class="btn btn-outline-danger btn-sm btn-custom"
                                                        data-bs-toggle="tooltip" data-bs-placement="top"
                                                        title="Delete this class">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>

                                            @if (Model.ClassInfo != null && Model.ClassInfo.Id == item.Id)
                                            {
                                                <div id="editPopup" class="update-popup fade-in">
                                                    <h5 class="mb-3 text-primary">
                                                        <i class="bi bi-pencil"></i> Update Class
                                                    </h5>
                                                    <form method="post">
                                                        <input type="hidden" asp-for="@Model.ClassInfo.Id" />

                                                        <div class="mb-3">
                                                            <label class="form-label">Class Name</label>
                                                            <input asp-for="@Model.ClassInfo.ClassName" class="form-control" />
                                                            <span asp-validation-for="@Model.ClassInfo.ClassName" class="text-danger"></span>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Student Count</label>
                                                            <input asp-for="@Model.ClassInfo.StudentCount" class="form-control" />
                                                            <span asp-validation-for="@Model.ClassInfo.StudentCount" class="text-danger"></span>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label">Description</label>
                                                            <textarea asp-for="@Model.ClassInfo.Description" class="form-control" rows="3"></textarea>
                                                            <span asp-validation-for="@Model.ClassInfo.Description" class="text-danger"></span>
                                                        </div>
                                                        <div class="d-flex justify-content-between">
                                                            <button type="submit" class="btn btn-sm btn-success btn-custom"
                                                                    asp-page-handler="Update">
                                                                <i class="bi bi-check-circle me-1"></i> Save
                                                            </button>
                                                            <form method="post">
                                                                <button type="submit" class="btn btn-sm btn-secondary btn-custom"
                                                                        asp-page-handler="CancelEdit">
                                                                    <i class="bi bi-arrow-left"></i> Cancel
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </form>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Pagination" class="mt-3">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link"
                                            href="?currentPage=@i&sortColumn=@Model.SortColumn&sortAscending=@Model.SortAscending">
                                            @i
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        /* AI Prompt: "Write JavaScript to automatically scroll to a popup element with id 'editPopup' after the page loads,
          using smooth scrolling and centering it in the viewport." */
        window.addEventListener("DOMContentLoaded", function () {
            const popup = document.getElementById("editPopup");
            if (popup) {
                popup.scrollIntoView({ behavior: "smooth", block: "center" });
            }
        });

        const searchBox = document.getElementById('searchBox');
        if (searchBox) {
            let timer;
            searchBox.addEventListener('input', function () {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    const v = this.value;
                    const url = new URL(window.location.href);
                    if (v.trim() === '') {
                        url.searchParams.delete('keyword');
                        url.searchParams.delete('currentPage');
                    } else {
                        url.searchParams.set('keyword', v);
                        url.searchParams.set('currentPage', 1);
                    }
                    window.location.href = url.toString();
                }, 300);
            });
        }
    </script>

    
    <script>

        // AI Prompt: "Implement a JavaScript function to handle row selection in a Bootstrap table.
        const selectedIds = new Set(JSON.parse(localStorage.getItem("selectedRows") || "[]"));

        document.querySelectorAll(".selectable-row").forEach(row => {
            const id = row.dataset.id;

            if (selectedIds.has(id)) {
                row.classList.add("table-active");
            }

            row.addEventListener("click", function () {
                if (selectedIds.has(id)) {
                    selectedIds.delete(id);
                    this.classList.remove("table-active");
                } else {
                    selectedIds.add(id);
                    this.classList.add("table-active");
                }

                localStorage.setItem("selectedRows", JSON.stringify([...selectedIds]));
                updateHiddenInputs();
            });
        });

        /* AI Prompt: "Create a JavaScript function to update hidden input fields based on selected rows in a Bootstrap table.
            This function should be called whenever a row is selected or deselected." */
        function updateHiddenInputs() {
            const container = document.getElementById("selectedRowInputs");
            const badge = document.getElementById("selectionCount");

            if (!container) return;

            container.innerHTML = "";

            selectedIds.forEach(id => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "selectedIds";
                input.value = id;
                container.appendChild(input);
            });

            if (badge) {
                const count = selectedIds.size;

                if (count > 0) {
                    badge.innerText = `${count} row${count > 1 ? 's' : ''} selected`;
                    badge.style.display = "inline-block";
                } else {
                    badge.style.display = "none";
                }
            }
        }


        window.addEventListener("DOMContentLoaded", updateHiddenInputs);
    </script>

    <script>
        // AI Prompt: "Add a JavaScript function to clear all selected rows in the Bootstrap table.
        // This should remove the 'table-active' class from all selected rows and clear the local storage."
        document.getElementById("clearSelectionBtn").addEventListener("click", () => {
            selectedIds.clear(); // <--- işte bu satırı ekliyoruz
            localStorage.removeItem("selectedRows");

            document.querySelectorAll(".selectable-row").forEach(row => {
                row.classList.remove("table-active");
            });

            updateHiddenInputs();
        });

    </script>

    <script>
    /* AI Prompt: "Add a JavaScript function to prevent row selection when clicking on buttons inside the row.
        This should ensure that clicking on buttons does not trigger the row selection event.*/
    document.querySelectorAll(".actions-cell button").forEach(btn => {
        btn.addEventListener("click", function (e) {
            e.stopPropagation();
        });
    });

    document.querySelectorAll(".actions-cell i").forEach(icon => {
        icon.addEventListener("click", function (e) {
            e.stopPropagation();
        });
    });

    /* AI Prompt: "Add a JavaScript function to prevent the popup from closing when clicking inside it.
        This should ensure that the popup remains open when interacting with its content." */
    document.querySelectorAll("#editPopup, #editPopup *").forEach(el => {
        el.addEventListener("click", function (e) {
            e.stopPropagation();
        });
    });

</script>

}
